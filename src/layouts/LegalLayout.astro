---
import Layout from "./Layout.astro";
import { Image } from "astro:assets";
import Logo from "../assets/logos/logo.webp";
import Footer from "./footer.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  legalTitle: string;
  updated: string;
}

const { title, description, canonical, legalTitle, updated } = Astro.props;
---

<Layout title={title} description={description} canonical={canonical}>
  <div class="min-h-screen flex flex-col">
    <header
      class="sticky top-0 z-40 bg-[var(--md-sys-color-surface-container-low)] md:bg-[#f4f3eff6] md:backdrop-blur-lg md:border-b md:border-white/30 border-b border-[var(--md-sys-color-outline-variant)]"
    >
      <div
        class="w-full max-w-4xl mx-auto flex items-center justify-between gap-4 px-5 py-3"
      >
        <a href="/" class="flex items-center gap-2.5 group shrink-0">
          <Image
            src={Logo}
            alt="PulsoBI Tech"
            class="h-9 w-auto"
            widths={[48, 96, 160]}
            sizes="48px"
          />
          <span
            class="font-bold text-lg tracking-tight font-nippo text-[var(--md-sys-color-on-surface)]"
          >
            PulsoBI <span class="text-sky-600">Tech</span>
          </span>
        </a>
        <a
          href="/"
          class="inline-flex items-center gap-2 h-9 px-4 rounded-xl text-sm font-semibold font-clash text-[var(--md-sys-color-on-surface-variant)] hover:text-[var(--md-sys-color-primary)] hover:bg-black/5 transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path>
          </svg>
          Volver al inicio
        </a>
      </div>
    </header>

    <main class="flex-1 w-full max-w-4xl mx-auto px-5 py-12 md:py-16">
      <p
        class="text-xs font-medium tracking-widest uppercase text-[var(--md-sys-color-primary)] mb-4 font-clash"
      >
        {updated}
      </p>
      <h1
        class="font-nippo text-[var(--md-sys-color-on-surface)] font-normal leading-tight mb-10"
        style="font-size: clamp(2rem, 5vw, 3rem); letter-spacing: -0.02em;"
      >
        {legalTitle}
      </h1>
      <slot />
    </main>

    <Footer />
  </div>
</Layout>

<style is:global>
  .legal-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .legal-content section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .legal-content h2 {
    font-family: "ClashDisplay", sans-serif;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.5rem;
    color: var(--md-sys-color-on-surface);
  }

  .legal-content p,
  .legal-content li {
    font-family: "ClashDisplay", sans-serif;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--md-sys-color-on-surface-variant);
  }

  .legal-content ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .legal-content a {
    color: var(--md-sys-color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal-content strong {
    color: var(--md-sys-color-on-surface);
    font-weight: 600;
  }

  .legal-content .legal-note {
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-medium);
    background: var(--md-sys-color-surface-container);
    padding: 1rem 1.25rem;
    font-size: 0.875rem;
  }
</style>
