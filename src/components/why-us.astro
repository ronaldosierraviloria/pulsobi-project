---
import { Icon } from "astro-icon/components";

const title =
  '<span class="bg-[var(--md-sys-color-on-surface)]]">¿Por qué Elegir </span><span class="font-nippo text-[var(--md-sys-color-tertiary)]">PulsoBI Tech?</span>';
const subTitle =
  "No solo entregamos soluciones, las adaptamos a tu negocio. Somos el socio estratégico que te acompaña en cada paso, desde el análisis hasta la ejecución.";

const features = [
  {
    borderClasses: "md:border-l md:border-r",
    gradientClasses:
      "bg-linear-to-l/oklch from-[var(--md-sys-color-primary-container)] to-transparent",
    icon: "lucide:shield",
    heading: "Atención Personalizada",
    description:
      "Al ser un equipo enfocado, cada proyecto recibe atención directa y soluciones hechas a la medida de tu negocio, no plantillas genéricas.",
  },
  {
    borderClasses: "border-b border-t md:border-b-0",
    gridClasses: "md:col-start-2 md:col-end-3",
    gradientClasses:
      "bg-linear-to-t/oklch from-[var(--md-sys-color-secondary-container)] to-transparent",
    icon: "lucide:clock",
    heading: "Tecnología Actual",
    description:
      "Trabajamos con las herramientas de IA y automatización más recientes del mercado, para que tu negocio no se quede atrás frente a la competencia.",
  },
  {
    borderClasses: "md:border-l md:border-r md:border-t",
    gridClasses: "md:col-end-4",
    gradientClasses:
      "bg-linear-to-tl/oklch from-[var(--md-sys-color-tertiary-container)] to-transparent",
    icon: "lucide:star",
    heading: "Compromiso y Cercanía",
    description:
      "Hablas directamente con quien desarrolla tu solución, sin intermediarios. Esto significa respuestas rápidas y ajustes ágiles en cada etapa del proyecto.",
  },
];
---

<section
  id="nosotros"
  class="bg-[var(--md-sys-color-surface-container-low)]"
>
  <div
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20 grid grid-flow-row-dense grid-cols-1 md:grid-cols-3 md:grid-rows-2"
  >
    <div
      class="mx-auto max-w-lg pb-5 text-center md:col-span-2 lg:mx-0 lg:flex-auto lg:text-left"
    >
      <h2
        class="text-2xl font-semibold tracking-tight text-balance text-slate-800 md:text-3xl md:leading-tight"
      >
        <Fragment set:html={title} />
      </h2>
      <p
        class="mt-6 text-start text-lg/8 text-pretty text-[var(--md-sys-color-on-surface-variant)] sm:text-center md:text-start"
      >
        {subTitle}
      </p>
    </div>

    {
      features.map((feature) => (
        <div
          class={`group relative mx-auto flex flex-col border-dashed border-[var(--md-sys-color-outline-variant)] py-10 w-full ${feature.borderClasses} ${feature.gridClasses}`}
        >
          <div
            class={`pointer-events-none absolute inset-0 h-full w-full ${feature.gradientClasses} opacity-0 transition duration-300 group-hover:opacity-100`}
          />
          <div class="relative z-10 mb-4 px-10 text-[var(--md-sys-color-primary)]">
            <Icon name={feature.icon} class="size-6" />
          </div>
          <div class="relative z-10 mb-2 px-10 text-lg font-semibold">
            <span class="inline-block text-balance text-[var(--md-sys-color-on-surface)] transition duration-300 group-hover:translate-x-2">
              {feature.heading}
            </span>
          </div>
          <p class="relative z-10 max-w-sm px-10 text-sm text-pretty text-[var(--md-sys-color-on-surface-variant)]">
            {feature.description}
          </p>
        </div>
      ))
    }
  </div>
</section>
