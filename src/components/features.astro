---
import { Icon } from "astro-icon/components";
---

<section
  class="features-dark flex flex-col items-center px-4 py-24 relative overflow-hidden"
>
  <!-- Subtle accent glow -->
  <div
    class="absolute top-0 right-0 w-[500px] h-[500px] bg-[var(--md-sys-color-tertiary-container)]/10 rounded-full blur-[120px] pointer-events-none"
  >
  </div>
  <h2
    class="text-4xl md:text-5xl font-medium text-center max-w-[600px] font-clash"
  >
    <span class="font-nippo text-[var(--md-sys-color-primary)]"
      >Funcionalidades
    </span>
    <span class="text-[var(--md-sys-color-on-surface)]"
      >que potencian tu negocio.</span
    >
  </h2>
  <p
    class="text-base text-[var(--md-sys-color-on-surface-variant)] text-center max-w-[500px] mt-4 font-clash"
  >
    Descubre las herramientas de análisis de datos, automatización con IA y
    desarrollo web que llevarán tu negocio al siguiente nivel.
  </p>

  <div class="flex flex-col gap-20 mt-20 w-full max-w-5xl">
    <!-- Row 1: Text + Animated Cards -->
    <div class="flex flex-col md:flex-row items-center gap-10 reveal-up">
      <div class="md:w-[30%]">
        <span></span>
        <h3
          class="text-2xl font-medium text-[var(--md-sys-color-on-surface-variant)]"
        >
          Integración de Fuentes de Datos
        </h3>
        <p
          class="text-base text-[var(--md-sys-color-on-surface)] mt-3 leading-relaxed"
        >
          Conecta bases de datos, APIs, archivos CSV y más en un solo lugar.
          Incluye limpieza y visualización de datos para que tengas siempre
          información clara y lista para decidir.
        </p>
        <div class="flex flex-wrap items-center gap-3 mt-5">
          <div
            class="flex items-center gap-2 px-3 py-2 rounded-lg bg-[var(--md-sys-color-surface-container-high)] border border-[var(--md-sys-color-outline-variant)] transition-all hover:scale-105 hover:-translate-y-1 hover:shadow-md hover:border-[var(--md-sys-color-primary)]"
          >
            <Icon
              name="lucide:database"
              class="size-8 text-[var(--md-sys-color-on-surface)]"
            />
            <span class="text-xs text-[var(--md-sys-color-on-surface-variant)]"
              >Bases de Datos</span
            >
          </div>
          <div
            class="flex items-center gap-2 px-3 py-2 rounded-lg bg-[var(--md-sys-color-surface-container-high)] border border-[var(--md-sys-color-outline-variant)] transition-all hover:scale-105 hover:-translate-y-1 hover:shadow-md hover:border-[var(--md-sys-color-primary)]"
          >
            <Icon
              name="simple-icons:microsoftexcel"
              class="size-8"
              style="color: #217346"
            />
            <span class="text-xs text-[var(--md-sys-color-on-surface-variant)]"
              >Excel</span
            >
          </div>
          <div
            class="flex items-center gap-2 px-3 py-2 rounded-lg bg-[var(--md-sys-color-surface-container-high)] border border-[var(--md-sys-color-outline-variant)] transition-all hover:scale-105 hover:-translate-y-1 hover:shadow-md hover:border-[var(--md-sys-color-primary)]"
          >
            <Icon
              name="simple-icons:powerbi"
              class="size-8"
              style="color: #F2C811"
            />
            <span class="text-xs text-[var(--md-sys-color-on-surface-variant)]"
              >Power BI</span
            >
          </div>
          <div
            class="flex items-center gap-2 px-3 py-2 rounded-lg bg-[var(--md-sys-color-surface-container-high)] border border-[var(--md-sys-color-outline-variant)] transition-all hover:scale-105 hover:-translate-y-1 hover:shadow-md hover:border-[var(--md-sys-color-primary)]"
          >
            <Icon
              name="simple-icons:looker"
              class="size-8 text-[var(--md-sys-color-on-surface)]"
            />
            <span class="text-xs text-[var(--md-sys-color-on-surface-variant)]"
              >Looker Studio</span
            >
          </div>
          <div
            class="flex items-center gap-2 px-3 py-2 rounded-lg bg-[var(--md-sys-color-surface-container-high)] border border-[var(--md-sys-color-outline-variant)] transition-all hover:scale-105 hover:-translate-y-1 hover:shadow-md hover:border-[var(--md-sys-color-primary)]"
          >
            <Icon
              name="simple-icons:python"
              class="size-8"
              style="color: #3776AB"
            />
            <span class="text-xs text-[var(--md-sys-color-on-surface-variant)]"
              >Python</span
            >
          </div>
          <div
            class="flex items-center gap-2 px-3 py-2 rounded-lg bg-[var(--md-sys-color-surface-container-high)] border border-[var(--md-sys-color-outline-variant)] transition-all hover:scale-105 hover:-translate-y-1 hover:shadow-md hover:border-[var(--md-sys-color-primary)]"
          >
            <Icon
              name="simple-icons:pandas"
              class="size-8"
              style="color: #150458"
            />
            <span class="text-xs text-[var(--md-sys-color-on-surface-variant)]"
              >Pandas</span
            >
          </div>
        </div>
      </div>
      <span></span>
      <div></div>
      <div
        class="hidden md:block md:w-[70%] w-full rounded-2xl border border-primary/30 overflow-hidden bg-background-secondary"
      >
        <!-- Terminal chrome header -->
        <div
          class="flex items-center gap-3 px-4 py-2.5 bg-background/60 border-b border-primary/10"
        >
          <div class="flex items-center gap-1.5 shrink-0">
            <div
              class="size-3 rounded-full bg-[#ff5f57] shadow-[0_0_4px_#ff5f57aa]"
            >
            </div>
            <div
              class="size-3 rounded-full bg-[#febc2e] shadow-[0_0_4px_#febc2eaa]"
            >
            </div>
            <div
              class="size-3 rounded-full bg-[#28c840] shadow-[0_0_4px_#28c840aa]"
            >
            </div>
          </div>
          <div class="flex-1 flex justify-center">
            <span
              class="text-[11px] font-mono text-content-secondary/60 tracking-wide"
            >
              ~/pulsobi/data-proccesing <span class="text-secondary/60">—</span> bash
            </span>
          </div>
          <div class="w-[54px] shrink-0"></div>
        </div>

        <div class="relative my-16 flex flex-col gap-y-7 lg:my-8">
          <!-- Card 1 -->
          <div
            class="z-10 flex w-48 flex-col self-start ml-20 mt-6 rounded-xl bg-background/70 p-4 shadow-lg ring-1 ring-surface-border backdrop-blur-xl"
          >
            <div
              class="flex size-10 items-center justify-center rounded-lg bg-violet/10"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-violet"
              >
                <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
              </svg>
            </div>
            <p class="mt-3 text-sm font-medium text-content">
              Conecta tus datos
            </p>
            <p class="mt-1 text-xs text-content-secondary">
              Fuentes, APIs y CSVs
            </p>
          </div>

          <!-- SVG Connector 1 → 2 -->
          <svg
            class="line-connector absolute z-0 hidden w-1/2 xl:top-[25%] xl:left-[22%] xl:block"
            viewBox="0 0 200 300"
          >
            <path
              class="base-line"
              d="M1 0.5V50C1 63.8071 12.1929 75 26 75H70"
              stroke="var(--color-primary)"
              stroke-width="1"
              fill="transparent"
              opacity="0.15"></path>
            <path
              class="beam-line"
              d="M1 0.5V50C1 63.8071 12.1929 75 26 75H70"
              stroke="var(--color-secondary)"
              stroke-width="2"
              fill="transparent"></path>
          </svg>

          <!-- Card 2 -->
          <div
            class="z-10 flex w-48 flex-col self-center ml-10 rounded-xl bg-background/70 p-4 shadow-lg ring-1 ring-surface-border backdrop-blur-xl"
          >
            <div
              class="flex size-10 items-center justify-center rounded-lg bg-accent/10"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-accent"
              >
                <path d="M3 3v18h18"></path>
                <path d="M7 16l4-8 4 4 4-6"></path>
              </svg>
            </div>
            <p class="mt-3 text-sm font-medium text-content">
              Procesamiento de información
            </p>
            <p class="mt-1 text-xs text-content-secondary">
              Proceso de limpieza, tratamiento y modelamiento de datos.
            </p>
          </div>

          <!-- SVG Connector 2 → 3 -->
          <svg
            class="line-connector absolute z-0 hidden w-1/2 xl:top-[55%] xl:left-[63%] xl:block"
            viewBox="0 0 200 300"
          >
            <path
              class="base-line"
              d="M0.5 1.5H56C69.8071 1.5 81 12.6929 81 26.5V73"
              stroke="var(--color-primary)"
              stroke-width="1"
              fill="transparent"
              opacity="0.15"></path>
            <path
              class="beam-line"
              d="M0.5 1.5H56C69.8071 1.5 81 12.6929 81 26.5V73"
              stroke="var(--color-secondary)"
              stroke-width="2"
              fill="transparent"></path>
          </svg>

          <!-- Card 3 -->
          <div
            class="z-10 flex w-48 flex-col self-end mr-10 rounded-xl bg-background/70 p-4 shadow-lg ring-1 ring-surface-border backdrop-blur-xl"
          >
            <div
              class="flex size-10 items-center justify-center rounded-lg bg-success/10"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-success"
              >
                <path
                  d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                ></path>
                <path d="M14 2v6h6"></path>
                <path d="M16 13H8"></path>
                <path d="M16 17H8"></path>
                <path d="M10 9H8"></path>
              </svg>
            </div>
            <p class="mt-3 text-sm font-medium text-content">
              Visualización de la información.
            </p>
            <p class="mt-1 text-xs text-content-secondary">
              Dashboard interactivo y dinamico que permite toma de desiciones
              estrategicas.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Row 2: AI Automation Flow -->
    <div
      class="flex flex-col md:flex-row-reverse items-center gap-10 reveal-up"
      style="transition-delay: 100ms;"
    >
      <div class="md:w-[30%]">
        <h3
          class="text-2xl font-medium text-[var(--md-sys-color-on-surface-variant)]"
        >
          Automatiza tus Procesos
        </h3>
        <p
          class="text-base text-[var(--md-sys-color-on-surface-variant)] mt-3 leading-relaxed"
        >
          Un agente de IA orquesta tus flujos de trabajo: recibe eventos, toma
          decisiones y ejecuta acciones en tus herramientas, sin intervención
          humana — para que tu equipo se enfoque en lo importante.
        </p>
        <div class="flex flex-wrap items-center gap-3 mt-5">
          <div
            class="flex items-center gap-2 px-3 py-2 rounded-lg bg-[var(--md-sys-color-surface-container-high)] border border-[var(--md-sys-color-outline-variant)] transition-all hover:scale-105 hover:-translate-y-1 hover:shadow-md hover:border-[var(--md-sys-color-primary)]"
          >
            <Icon
              name="simple-icons:python"
              class="size-8"
              style="color: #3776AB"
            />
            <span class="text-xs text-[var(--md-sys-color-on-surface-variant)]"
              >Python</span
            >
          </div>
          <div
            class="flex items-center gap-2 px-3 py-2 rounded-lg bg-[var(--md-sys-color-surface-container-high)] border border-[var(--md-sys-color-outline-variant)] transition-all hover:scale-105 hover:-translate-y-1 hover:shadow-md hover:border-[var(--md-sys-color-primary)]"
          >
            <Icon
              name="lucide:brain-circuit"
              class="size-8 text-[var(--md-sys-color-on-surface)]"
            />
            <span class="text-xs text-[var(--md-sys-color-on-surface-variant)]"
              >IA</span
            >
          </div>
          <div
            class="flex items-center gap-2 px-3 py-2 rounded-lg bg-[var(--md-sys-color-surface-container-high)] border border-[var(--md-sys-color-outline-variant)] transition-all hover:scale-105 hover:-translate-y-1 hover:shadow-md hover:border-[var(--md-sys-color-primary)]"
          >
            <Icon
              name="simple-icons:n8n"
              class="size-8 text-[var(--md-sys-color-on-surface)]"
            />
            <span class="text-xs text-[var(--md-sys-color-on-surface-variant)]"
              >N8N</span
            >
          </div>
        </div>
      </div>
      <div
        class="hidden md:block md:w-[70%] w-full rounded-2xl border border-primary/30 overflow-hidden bg-background-secondary"
      >
        <!-- Terminal chrome header -->
        <div
          class="flex items-center gap-3 px-4 py-2.5 bg-background/60 border-b border-primary/10"
        >
          <!-- Traffic-light dots -->
          <div class="flex items-center gap-1.5 shrink-0">
            <div
              class="size-3 rounded-full bg-[#ff5f57] shadow-[0_0_4px_#ff5f57aa]"
            >
            </div>
            <div
              class="size-3 rounded-full bg-[#febc2e] shadow-[0_0_4px_#febc2eaa]"
            >
            </div>
            <div
              class="size-3 rounded-full bg-[#28c840] shadow-[0_0_4px_#28c840aa]"
            >
            </div>
          </div>
          <!-- Centered path label -->
          <div class="flex-1 flex justify-center">
            <span
              class="text-[11px] font-mono text-content-secondary/60 tracking-wide"
            >
              ~/pulsobi/automation-agent <span class="text-secondary/60">—</span
              > bash
            </span>
          </div>
          <!-- Spacer to balance the dots -->
          <div class="w-[54px] shrink-0"></div>
        </div>

        <!-- Automation Flow -->
        <div
          class="relative flex items-center justify-between px-8 py-8"
          style="min-height: 280px;"
        >
          <!-- SVG animated lines + particles overlay -->
          <svg
            class="absolute inset-0 w-full h-full pointer-events-none"
            viewBox="0 0 660 280"
            preserveAspectRatio="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <!-- Glow filter for particles -->
              <filter
                id="glow-primary"
                x="-50%"
                y="-50%"
                width="200%"
                height="200%"
              >
                <feGaussianBlur stdDeviation="2.5" result="blur"
                ></feGaussianBlur>
                <feMerge
                  ><feMergeNode in="blur"></feMergeNode><feMergeNode
                    in="SourceGraphic"></feMergeNode></feMerge
                >
              </filter>
              <filter
                id="glow-secondary"
                x="-50%"
                y="-50%"
                width="200%"
                height="200%"
              >
                <feGaussianBlur stdDeviation="2.5" result="blur"
                ></feGaussianBlur>
                <feMerge
                  ><feMergeNode in="blur"></feMergeNode><feMergeNode
                    in="SourceGraphic"></feMergeNode></feMerge
                >
              </filter>
              <!-- Left-to-center path definitions for animateMotion -->
              <path id="p-l1" d="M180,66 C215,66 215,150 248,150"></path>
              <path id="p-l2" d="M180,150 L248,150"></path>
              <path id="p-l3" d="M180,234 C215,234 215,150 248,150"></path>
              <!-- Center-to-right path definitions -->
              <path id="p-r1" d="M412,150 C445,150 445,66 480,66"></path>
              <path id="p-r2" d="M412,150 L480,150"></path>
              <path id="p-r3" d="M412,150 C445,150 445,234 480,234"></path>
            </defs>

            <!-- Connection dots at left cards -->
            <circle
              cx="180"
              cy="66"
              r="3"
              fill="var(--color-primary)"
              opacity="0.5"></circle>
            <circle
              cx="180"
              cy="150"
              r="3"
              fill="var(--color-primary)"
              opacity="0.5"></circle>
            <circle
              cx="180"
              cy="234"
              r="3"
              fill="var(--color-primary)"
              opacity="0.5"></circle>
            <!-- Connection dots at right cards -->
            <circle
              cx="480"
              cy="66"
              r="3"
              fill="var(--color-secondary)"
              opacity="0.5"></circle>
            <circle
              cx="480"
              cy="150"
              r="3"
              fill="var(--color-secondary)"
              opacity="0.5"></circle>
            <circle
              cx="480"
              cy="234"
              r="3"
              fill="var(--color-secondary)"
              opacity="0.5"></circle>

            <!-- Base paths dim – Left → Center -->
            <path
              d="M180,66 C215,66 215,150 248,150"
              stroke="var(--color-primary)"
              stroke-width="1.5"
              fill="none"
              opacity="0.15"></path>
            <path
              d="M180,150 L248,150"
              stroke="var(--color-primary)"
              stroke-width="1.5"
              fill="none"
              opacity="0.15"></path>
            <path
              d="M180,234 C215,234 215,150 248,150"
              stroke="var(--color-primary)"
              stroke-width="1.5"
              fill="none"
              opacity="0.15"></path>
            <!-- Base paths dim – Center → Right -->
            <path
              d="M412,150 C445,150 445,66 480,66"
              stroke="var(--color-secondary)"
              stroke-width="1.5"
              fill="none"
              opacity="0.15"></path>
            <path
              d="M412,150 L480,150"
              stroke="var(--color-secondary)"
              stroke-width="1.5"
              fill="none"
              opacity="0.15"></path>
            <path
              d="M412,150 C445,150 445,234 480,234"
              stroke="var(--color-secondary)"
              stroke-width="1.5"
              fill="none"
              opacity="0.15"></path>

            <!-- Animated beam strokes – Left → Center -->
            <path
              class="flow-beam"
              style="animation-delay:0s"
              d="M180,66 C215,66 215,150 248,150"
              stroke="var(--color-primary)"
              stroke-width="2"
              fill="none"></path>
            <path
              class="flow-beam"
              style="animation-delay:0.9s"
              d="M180,150 L248,150"
              stroke="var(--color-primary)"
              stroke-width="2"
              fill="none"></path>
            <path
              class="flow-beam"
              style="animation-delay:1.8s"
              d="M180,234 C215,234 215,150 248,150"
              stroke="var(--color-primary)"
              stroke-width="2"
              fill="none"></path>
            <!-- Animated beam strokes – Center → Right -->
            <path
              class="flow-beam"
              style="animation-delay:0.45s"
              d="M412,150 C445,150 445,66 480,66"
              stroke="var(--color-secondary)"
              stroke-width="2"
              fill="none"></path>
            <path
              class="flow-beam"
              style="animation-delay:1.35s"
              d="M412,150 L480,150"
              stroke="var(--color-secondary)"
              stroke-width="2"
              fill="none"></path>
            <path
              class="flow-beam"
              style="animation-delay:2.25s"
              d="M412,150 C445,150 445,234 480,234"
              stroke="var(--color-secondary)"
              stroke-width="2"
              fill="none"></path>

            <!-- Travelling particles – Left → Center (primary) -->
            <circle
              r="4"
              fill="var(--color-primary)"
              filter="url(#glow-primary)"
              opacity="0.9"
            >
              <animateMotion
                dur="2s"
                begin="0s"
                repeatCount="indefinite"
                rotate="auto"
              >
                <mpath href="#p-l1"></mpath>
              </animateMotion>
              <animate
                attributeName="opacity"
                values="0;1;1;0"
                dur="2s"
                begin="0s"
                repeatCount="indefinite"></animate>
            </circle>
            <circle
              r="4"
              fill="var(--color-primary)"
              filter="url(#glow-primary)"
              opacity="0.9"
            >
              <animateMotion
                dur="2s"
                begin="0.9s"
                repeatCount="indefinite"
                rotate="auto"
              >
                <mpath href="#p-l2"></mpath>
              </animateMotion>
              <animate
                attributeName="opacity"
                values="0;1;1;0"
                dur="2s"
                begin="0.9s"
                repeatCount="indefinite"></animate>
            </circle>
            <circle
              r="4"
              fill="var(--color-primary)"
              filter="url(#glow-primary)"
              opacity="0.9"
            >
              <animateMotion
                dur="2s"
                begin="1.8s"
                repeatCount="indefinite"
                rotate="auto"
              >
                <mpath href="#p-l3"></mpath>
              </animateMotion>
              <animate
                attributeName="opacity"
                values="0;1;1;0"
                dur="2s"
                begin="1.8s"
                repeatCount="indefinite"></animate>
            </circle>

            <!-- Travelling particles – Center → Right (secondary) -->
            <circle
              r="4"
              fill="var(--color-secondary)"
              filter="url(#glow-secondary)"
              opacity="0.9"
            >
              <animateMotion
                dur="2s"
                begin="0.45s"
                repeatCount="indefinite"
                rotate="auto"
              >
                <mpath href="#p-r1"></mpath>
              </animateMotion>
              <animate
                attributeName="opacity"
                values="0;1;1;0"
                dur="2s"
                begin="0.45s"
                repeatCount="indefinite"></animate>
            </circle>
            <circle
              r="4"
              fill="var(--color-secondary)"
              filter="url(#glow-secondary)"
              opacity="0.9"
            >
              <animateMotion
                dur="2s"
                begin="1.35s"
                repeatCount="indefinite"
                rotate="auto"
              >
                <mpath href="#p-r2"></mpath>
              </animateMotion>
              <animate
                attributeName="opacity"
                values="0;1;1;0"
                dur="2s"
                begin="1.35s"
                repeatCount="indefinite"></animate>
            </circle>
            <circle
              r="4"
              fill="var(--color-secondary)"
              filter="url(#glow-secondary)"
              opacity="0.9"
            >
              <animateMotion
                dur="2s"
                begin="2.25s"
                repeatCount="indefinite"
                rotate="auto"
              >
                <mpath href="#p-r3"></mpath>
              </animateMotion>
              <animate
                attributeName="opacity"
                values="0;1;1;0"
                dur="2s"
                begin="2.25s"
                repeatCount="indefinite"></animate>
            </circle>
          </svg>

          <!-- Left: Trigger / Input nodes -->
          <div class="flex flex-col gap-4 z-10 shrink-0">
            <!-- Email / Formulario -->
            <div
              class="flex items-center gap-2.5 rounded-xl bg-background/70 p-3 ring-1 ring-surface-border backdrop-blur-xl w-[148px]"
