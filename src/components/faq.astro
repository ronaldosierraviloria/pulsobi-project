---

<section
    class="features-dark flex flex-col items-center px-4 py-24 relative overflow-hidden"
>
    <div
        class="absolute top-0 right-0 w-[500px] h-[500px] bg-[var(--md-sys-color-tertiary-container)]/10 rounded-full blur-[120px] pointer-events-none"
    >
    </div>
    <h2
        class="text-4xl md:text-5xl font-medium text-center max-w-[600px] font-clash reveal-up"
    >
        <span
            class="font-nippo text-transparent bg-clip-text bg-gradient-to-r from-[var(--md-sys-color-primary)] to-[var(--md-sys-color-tertiary)]"
            >Preguntas
        </span>
        <span class="text-[var(--md-sys-color-on-surface)]"> y Respuestas</span>
    </h2>
    <p
        class="text-base text-[var(--md-sys-color-on-surface-variant)] text-center max-w-[500px] mt-4 font-clash reveal-up"
        style="transition-delay: 100ms;"
    >
        Encuentra respuestas a las preguntas más frecuentes sobre nuestros
        servicios de análisis de datos, automatización con IA y desarrollo web.
    </p>

    <div
        class="max-w-4xl w-full mx-auto px-4 md:px-0 py-10 reveal-up"
        style="transition-delay: 200ms;"
    >
        <div id="faqContainer" class="grid grid-cols-1 gap-y-4 items-start"></div>
    </div>
</section>

<script>
    const faqs = [
        {
            question: "¿Qué es Pulsobi y qué servicios ofrece?",
            answer: "Pulsobi es una agencia especializada en análisis de datos, automatización con inteligencia artificial y desarrollo web personalizado, para impulsar el crecimiento de tu negocio.",
        },
        {
            question: "¿Para qué tipo de negocio son sus servicios?",
            answer: "Trabajamos con negocios de cualquier tamaño que quieran tomar mejores decisiones con sus datos, automatizar tareas repetitivas o mejorar su presencia digital, sin importar si es la primera vez que implementan este tipo de soluciones.",
        },
        {
            question: "¿Cómo es el proceso para trabajar con ustedes?",
            answer: "Empezamos con una conversación para entender tus necesidades y objetivos. Luego te presentamos una propuesta clara con alcance y tiempos, y trabajamos contigo en cada etapa hasta la entrega final, con comunicación directa durante todo el proyecto.",
        },
        {
            question: "¿Qué herramientas y tecnologías utilizan?",
            answer: "Trabajamos con herramientas como Excel, Power BI, Looker Studio, Python y Pandas para análisis de datos y automatización, y con Astro, React y TailwindCSS para el desarrollo de páginas web modernas y rápidas.",
        },
        {
            question: "¿Ofrecen soporte después de entregar el proyecto?",
            answer: "Sí, brindamos acompañamiento después de la entrega para resolver dudas, hacer ajustes y asegurarnos de que la solución siga funcionando correctamente para tu negocio.",
        },
        {
            question: "¿Cómo empiezo a trabajar con Pulsobi?",
            answer: "Solo contáctanos y cuéntanos qué necesitas. Agendamos una conversación inicial sin compromiso para entender tu proyecto y ver cómo podemos ayudarte.",
        },
    ];

    const container = document.getElementById("faqContainer");
    const items = [];

    faqs.forEach((faq, index) => {
        const wrapper = document.createElement("div");
        wrapper.className =
            "faq-item rounded-2xl border border-[var(--md-sys-color-outline-variant)] bg-[var(--md-sys-color-surface-container-low)]/40 overflow-hidden transition-colors duration-300";

        const button = document.createElement("button");
        button.type = "button";
        button.className =
            "faq-btn group w-full flex items-center justify-between gap-4 p-5 text-left cursor-pointer transition-colors";
        button.setAttribute("aria-expanded", "false");
        button.innerHTML = `
            <h3 class="text-base font-medium text-[var(--md-sys-color-on-surface)] group-hover:text-[var(--md-sys-color-primary)] transition-colors font-clash">${faq.question}</h3>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="faq-icon shrink-0 transition-transform duration-500 ease-in-out text-[var(--md-sys-color-on-surface-variant)]">
                <path d="m4.5 7.2 3.793 3.793a1 1 0 0 0 1.414 0L13.5 7.2"
                    stroke="currentColor" stroke-width="1.5"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        `;

        const answerWrap = document.createElement("div");
        answerWrap.className =
            "faq-answer overflow-hidden transition-all duration-500 ease-in-out max-h-0 opacity-0";
        const divider = document.createElement("div");
        divider.className = "mx-5 h-px bg-[var(--md-sys-color-outline-variant)]";
        const answer = document.createElement("p");
        answer.className =
            "px-5 pb-5 pt-4 text-sm text-[var(--md-sys-color-on-surface-variant)] leading-relaxed font-clash";
        answer.textContent = faq.answer;

        answerWrap.appendChild(divider);
        answerWrap.appendChild(answer);
        wrapper.appendChild(button);
        wrapper.appendChild(answerWrap);
        container.appendChild(wrapper);

        items.push({ wrapper, button, answerWrap, icon: button.querySelector(".faq-icon") });

        button.addEventListener("click", () => toggle(index));
    });

    function toggle(activeIndex) {
        items.forEach((item, i) => {
            const isOpen = i === activeIndex && !item.answerWrap.classList.contains("opacity-100");
            item.answerWrap.classList.toggle("opacity-100", isOpen);
            item.answerWrap.classList.toggle("max-h-[300px]", isOpen);
            item.answerWrap.classList.toggle("max-h-0", !isOpen);
            item.icon.classList.toggle("rotate-180", isOpen);
            item.wrapper.classList.toggle("border-[var(--md-sys-color-primary)]", isOpen);
            item.button.setAttribute("aria-expanded", String(isOpen));
        });
    }
</script>

<style>
    .features-dark {
        --md-sys-color-primary: #a3c8ff;
        --md-sys-color-on-primary: #00315c;
        --md-sys-color-primary-container: #004884;
        --md-sys-color-on-primary-container: #d4e4ff;
        --md-sys-color-secondary: #a4c8e8;
        --md-sys-color-on-secondary: #08354f;
        --md-sys-color-secondary-container: #214d67;
        --md-sys-color-on-secondary-container: #cce5ff;
        --md-sys-color-tertiary: #c5c0ea;
        --md-sys-color-on-tertiary: #302b60;
        --md-sys-color-tertiary-container: #474278;
        --md-sys-color-on-tertiary-container: #e4dfff;
        --md-sys-color-surface: #111318;
        --md-sys-color-on-surface: #e1e2e8;
        --md-sys-color-surface-variant: #41484f;
        --md-sys-color-on-surface-variant: #c1c8d5;
        --md-sys-color-surface-container-lowest: #0c0e13;
        --md-sys-color-surface-container-low: #191c20;
        --md-sys-color-surface-container: #1d2024;
        --md-sys-color-surface-container-high: #272b2f;
        --md-sys-color-surface-container-highest: #32353a;
        --md-sys-color-outline: #8b939e;
        --md-sys-color-outline-variant: #41484f;
        --md-sys-color-inverse-surface: #e1e2e8;
        --md-sys-color-inverse-on-surface: #2e3036;
        --md-sys-color-inverse-primary: #1a4a7a;

        background: var(--md-sys-color-surface-container-lowest);
        color: var(--md-sys-color-on-surface);
    }
</style>
