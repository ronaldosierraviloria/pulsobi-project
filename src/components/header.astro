---
import { Image } from "astro:assets";
import DashboardDark from "../assets/dashboard-darkmode.webp";
import ScreenWebp from "../assets/dashboardimages/screen.webp";
import Navbar from "./navbar.astro";
---

<header
    class="relative overflow-hidden w-full m-0 p-0 transition-colors duration-500 min-h-[85vh] flex flex-col justify-between bg-[#080b11]"
>
    <!-- Subtle Navy/Blue Tech Circuit Background Layer -->
    <div
        class="absolute inset-0 pointer-events-none overflow-hidden select-none z-0"
    >
        <!-- Soft Ambient Blue Orbs Glow -->
        <div
            class="absolute -top-32 -left-32 w-[600px] h-[600px] bg-sky-900/15 rounded-full blur-[140px]"
        >
        </div>
        <div
            class="absolute -bottom-32 -right-32 w-[600px] h-[600px] bg-blue-950/20 rounded-full blur-[140px]"
        >
        </div>
        <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[#1A4A7A]/10 rounded-full blur-[160px]"
        >
        </div>

        <!-- SVG Subtle Circuit Pattern -->
        <svg
            class="absolute inset-0 w-full h-full object-cover opacity-65"
            viewBox="0 0 1920 1080"
            preserveAspectRatio="xMidYMid slice"
            xmlns="http://www.w3.org/2000/svg"
        >
            <defs>
                <!-- Soft Glow Filter -->
                <filter
                    id="soft-blue-glow"
                    x="-20%"
                    y="-20%"
                    width="140%"
                    height="140%"
                >
                    <feGaussianBlur stdDeviation="2.5" result="blur"
                    ></feGaussianBlur>
                    <feMerge>
                        <feMergeNode in="blur"></feMergeNode>
                        <feMergeNode in="SourceGraphic"></feMergeNode>
                    </feMerge>
                </filter>

                <!-- Blue Gradient for Circuit Lines -->
                <linearGradient
                    id="blue-circuit-grad"
                    x1="0%"
                    y1="0%"
                    x2="100%"
                    y2="100%"
                >
                    <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.3"
                    ></stop>
                    <stop offset="35%" stop-color="#0284c7" stop-opacity="0.8"
                    ></stop>
                    <stop offset="70%" stop-color="#1A4A7A" stop-opacity="0.9"
                    ></stop>
                    <stop offset="100%" stop-color="#0f2b48" stop-opacity="0.3"
                    ></stop>
                </linearGradient>
            </defs>

            <g
                stroke="url(#blue-circuit-grad)"
                stroke-width="2.5"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                filter="url(#soft-blue-glow)"
            >
                <!-- Top-Left Diagonals -->
                <path d="M 100,-10 L 320,210"></path>
                <path d="M 160,280 L 340,460"></path>
                <path d="M 320,300 L 520,500"></path>

                <!-- Top-Center & Top-Right Circuit Line -->
                <path d="M 870,0 L 960,-90"></path>
                <path d="M 850,270 L 990,140 L 1330,140 L 1480,0"></path>
                <path d="M 1530,170 L 1610,250"></path>
                <path d="M 1710,140 L 1850,280"></path>

                <!-- Bottom-Left Circuit Lines -->
                <path d="M 60,770 L 180,770 L 420,770 L 600,590"></path>
                <path d="M 60,845 L 340,845"></path>
                <path
                    d="M 590,1090 L 740,940 L 860,940 L 990,830 L 1180,830 L 1370,1020 L 1570,1020 L 1720,1170"
                ></path>

                <!-- Bottom-Right Circuit Lines -->
                <path d="M 1300,610 L 1320,630 L 1650,640 L 1800,790"></path>
                <path d="M 1440,460 L 1580,320"></path>
            </g>
        </svg>
    </div>

    <!-- Navigation -->
    <Navbar />

    <!-- 2-Column Hero Layout -->
    <div
        class="relative z-10 w-full max-w-7xl mx-auto px-6 pt-28 md:pt-36 pb-16 md:pb-24 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center flex-1"
    >
        <!-- Left Column: Text & CTAs -->
        <div class="lg:col-span-6 flex flex-col items-start text-left">
            <!-- Main Headline -->
            <h1
                class="text-4xl sm:text-5xl md:text-6xl font-medium tracking-tight text-white font-clash leading-[1.08]"
            >
                El Futuro De Tu Negocio Empieza Con:
            </h1>

            <!-- Clean Animated Word -->
            <div class="my-3 min-h-[60px] md:min-h-[80px] flex items-center">
                <span
                    id="animated-word"
                    class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-normal text-transparent bg-clip-text bg-gradient-to-r from-sky-400 via-blue-400 to-[#1A4A7A] font-nippo tracking-tight block"
                >
                    Estrategia
                </span>
            </div>

            <!-- Subtitle -->
            <p
                class="text-base sm:text-lg text-sky-100/80 max-w-lg leading-relaxed font-normal mt-2"
            >
                Creamos páginas web, automatizamos procesos y convertimos tus
                datos en decisiones inteligentes.
            </p>

            <!-- Minimal CTA Group -->
            <div
                class="mt-8 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto"
            >
                <a
                    href="#contacto"
                    class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-full text-base font-medium text-white bg-[#1A4A7A] hover:bg-[#153b62] active:scale-95 transition-all duration-200 shadow-md"
                >
                    <span>Comenzar Ahora</span>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                        ></path></svg
                    >
                </a>

                <a
                    href="#servicios"
                    class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full text-base font-medium text-sky-100 hover:text-white bg-white/10 hover:bg-white/20 backdrop-blur-md transition-all duration-200 shadow-sm border border-sky-400/20"
                >
                    <span>Ver Servicios</span>
                </a>
            </div>
        </div>

        <!-- Right Column: Image Comparison Slider -->
        <div class="lg:col-span-6 w-full flex justify-center lg:justify-end">
            <div
                id="compare-container"
                class="relative w-full max-w-xl lg:max-w-none rounded-2xl md:rounded-3xl overflow-hidden border border-white/10 shadow-2xl shadow-sky-950/20 select-none cursor-col-resize"
                style="touch-action: none;"
            >
                <!-- After (right side) image: header-bg.webp -->
                <Image
                    src={ScreenWebp}
                    alt="Vista Antes"
                    class="w-full object-cover block"
                    quality={85}
                    widths={[480, 720, 1024, 1600]}
                    sizes="(min-width: 1024px) 46vw, (min-width: 640px) 75vw, 90vw"
                    priority
                    id="compare-after"
                />

                <!-- Before (left side) image: dashboard-darkmode.png, clipped -->
                <div
                    id="compare-before-wrap"
                    class="absolute inset-0 overflow-hidden"
                    style="clip-path: inset(0 50% 0 0);"
                >
                    <Image
                        src={DashboardDark}
                        alt="Vista Después"
                        class="w-full h-full object-cover block"
                        quality={85}
                        widths={[480, 720, 1024, 1600]}
                        sizes="(min-width: 1024px) 46vw, (min-width: 640px) 75vw, 90vw"
                        loading="eager"
                    />
                </div>

                <!-- Divider Line -->
                <div
                    id="compare-divider"
                    class="absolute top-0 bottom-0 w-[2px] bg-white/70"
                    style="left: 50%; transform: translateX(-50%);"
                >
                    <!-- Handle -->
                    <div
                        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white shadow-lg flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="#1A4A7A"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M9 18l-6-6 6-6"></path>
                            <path d="M15 6l6 6-6 6"></path>
                        </svg>
                    </div>
                </div>

                <!-- Labels -->
                <span
                    class="absolute top-3 left-3 text-xs font-semibold bg-black/50 text-white px-2.5 py-1 rounded-full backdrop-blur-sm pointer-events-none"
                    >Dark Mode</span
                >
                <span
                    class="absolute top-3 right-3 text-xs font-semibold bg-black/50 text-white px-2.5 py-1 rounded-full backdrop-blur-sm pointer-events-none"
                    >Light Mode</span
                >
            </div>
        </div>
    </div>
</header>

<style is:inline>
    header {
        --md-sys-color-primary: #1a4a7a;
        --md-sys-color-on-primary: #ffffff;
        --md-sys-color-surface: #080b11;
        --md-sys-color-on-surface: #f0f7ff;
    }
</style>

<script>
    const words = ["Estrategia", "Automatización", "Datos"];
    const wordEl = document.getElementById("animated-word");
    let wordIndex = 0;

    const prefersReduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    function cycleWords() {
        if (!wordEl) return;
        if (prefersReduced) {
            wordIndex = (wordIndex + 1) % words.length;
            wordEl.textContent = words[wordIndex];
            return;
        }

        const out = wordEl.animate(
            [
                {
                    opacity: 1,
                    transform: "translateY(0)",
                    filter: "blur(0)",
                },
                {
                    opacity: 0,
                    transform: "translateY(-10px)",
                    filter: "blur(2px)",
                },
            ],
            { duration: 350, easing: "ease-in", fill: "forwards" },
        );

        out.onfinish = () => {
            wordIndex = (wordIndex + 1) % words.length;
            wordEl.textContent = words[wordIndex];

            wordEl.animate(
                [
                    {
                        opacity: 0,
                        transform: "translateY(10px)",
                        filter: "blur(2px)",
                    },
                    {
                        opacity: 1,
                        transform: "translateY(0)",
                        filter: "blur(0)",
                    },
                ],
                { duration: 350, easing: "ease-out", fill: "forwards" },
            );
        };
    }

    setInterval(cycleWords, 4500);

    // --- Image Comparison Slider ---
    const container = document.getElementById("compare-container");
    const beforeWrap = document.getElementById("compare-before-wrap");
    const divider = document.getElementById("compare-divider");

    if (container && beforeWrap && divider) {
        let dragging = false;

        function setPosition(clientX: number) {
            const rect = container!.getBoundingClientRect();
            let pct = ((clientX - rect.left) / rect.width) * 100;
            pct = Math.max(2, Math.min(98, pct));
            const right = 100 - pct;
            beforeWrap!.style.clipPath = `inset(0 ${right}% 0 0)`;
            divider!.style.left = `${pct}%`;
        }

        container.addEventListener("mousedown", (e) => {
            dragging = true;
            setPosition(e.clientX);
        });
        window.addEventListener("mousemove", (e) => {
            if (dragging) setPosition(e.clientX);
        });
        window.addEventListener("mouseup", () => {
            dragging = false;
        });

        container.addEventListener(
            "touchstart",
            (e) => {
                dragging = true;
                setPosition(e.touches[0].clientX);
            },
            { passive: true },
        );
        window.addEventListener(
            "touchmove",
            (e) => {
                if (dragging) setPosition(e.touches[0].clientX);
            },
            { passive: true },
        );
        window.addEventListener("touchend", () => {
            dragging = false;
        });
    }
</script>
